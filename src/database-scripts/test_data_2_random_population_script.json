const categories = [
"Electronics",
"Furniture",
"Fashion",
"Grocery",
"Sports"
];

const subCategories = {
Electronics: ["Laptop", "Mobile", "TV"],
Furniture: ["Chair", "Table", "Dining"],
Fashion: ["Footwear", "Shirt", "Jeans"],
Grocery: ["Dairy", "Food", "Beverages"],
Sports: ["Cricket", "Football", "Fitness"]
};

const sellers = [
"Amazon",
"Flipkart",
"Reliance Digital",
"Croma",
"BigBasket",
"Ikea",
"Nike Store",
"Adidas Store"
];

const locations = [
"Chennai",
"Bengaluru",
"Hyderabad",
"Mumbai",
"Delhi"
];

const inventories = [];

for (let i = 1; i <= 50; i++) {

const category =
categories[Math.floor(Math.random() * categories.length)];

const subCategory =
subCategories[category][
Math.floor(
Math.random() *
subCategories[category].length
)
];

inventories.push({
name: `${category}-${subCategory}-${i}`,

category: category,

subCategory: subCategory,

manufacturingDate: new Date(
2024,
Math.floor(Math.random() * 12),
Math.floor(Math.random() * 28) + 1
),

expiryDate: new Date(
2030,
Math.floor(Math.random() * 12),
Math.floor(Math.random() * 28) + 1
),

specification: `Specification ${i}`,

price:
Math.floor(Math.random() * 90000) + 1000,

stock:
Math.floor(Math.random() * 500) + 1,

model: `MODEL-${i}`,

seller:
sellers[
Math.floor(
Math.random() * sellers.length
)
],

location:
locations[
Math.floor(
Math.random() * locations.length
)
]
});
}

db.inventories.insertMany(inventories);